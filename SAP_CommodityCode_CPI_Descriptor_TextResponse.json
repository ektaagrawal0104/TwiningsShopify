{
  "swagger": "2.0",
  "info": {
    "title": "SAP Commodity Code CPI Assignment API",
    "description": "Single-object JSON request to SAP CPI. The CPI endpoint returns an XML response; this descriptor models the response as raw text to avoid JSON object deserialization.",
    "version": "1.1.0"
  },
  "host": "dev-optimus-d07lurdy.it-cpi005-rt.cfapps.eu20.hana.ondemand.com",
  "basePath": "/http/mtd/k2",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "text/plain",
    "application/xml"
  ],
  "paths": {
    "/inbound": {
      "post": {
        "operationId": "AssignCommodityCode",
        "summary": "Assign commodity code to material",
        "description": "Submits one commodity assignment object directly as the JSON request body. Tested with POST and Basic Auth in Postman.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CommodityCodeAssignment"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Raw CPI response body (the endpoint currently returns XML, for example <assign_material>...</assign_material>). Treat response as text rather than a JSON object.",
            "schema": {
              "type": "string"
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Server or integration flow error"
          },
          "default": {
            "description": "Raw error response from CPI, if any.",
            "schema": {
              "type": "string"
            }
          }
        },
        "security": [
          {
            "basicAuth": []
          }
        ]
      }
    }
  },
  "definitions": {
    "CommodityCodeAssignment": {
      "type": "object",
      "required": [
        "matnr",
        "stcts",
        "comco",
        "spras",
        "text",
        "datab",
        "datbi"
      ],
      "properties": {
        "matnr": {
          "type": "string",
          "description": "Material number",
          "example": "709014759"
        },
        "stcts": {
          "type": "string",
          "description": "Trade classification numbering scheme",
          "example": "ZGHS"
        },
        "comco": {
          "type": "string",
          "description": "Commodity code",
          "example": "0902 30"
        },
        "spras": {
          "type": "string",
          "description": "Language key",
          "example": "EN"
        },
        "text": {
          "type": "string",
          "description": "Assignment text",
          "example": "Test"
        },
        "datab": {
          "type": "string",
          "description": "Valid-from date/time, ISO format",
          "example": "2026-09-26T00:00:00"
        },
        "datbi": {
          "type": "string",
          "description": "Valid-to date/time, ISO format",
          "example": "2026-11-01T23:59:59"
        }
      }
    }
  },
  "securityDefinitions": {
    "basicAuth": {
      "type": "basic",
      "description": "Use the CPI username and password supplied by the integration team."
    }
  }
}